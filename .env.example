# ==============================================================================
# SHOBHA EDUCATION TRUST — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Leave empty or set to use local embedded persistent MongoDB engine)
# For external MongoDB (Atlas / self-hosted): mongodb://localhost:27017/shobha_education_trust
MONGODB_URI=

# Security & Authentication
# Generate a strong 64-character random secret in production
JWT_SECRET=super_secret_jwt_key_shobha_education_trust_2026_dev_mode_change_in_prod
COOKIE_SECURE=false

# Initial Administrator Provisioning
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@SET2026!
ADMIN_NAME=Trust Administration

# Razorpay Payment Gateway (Test Mode / Live Mode)
# Replace with actual keys from your Razorpay Dashboard (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_expose_to_client
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_never_expose

# File Upload Configuration
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=data/uploads

# ==============================================================================
# MAIL ENQUIRY SYSTEM CONFIGURATION
# ==============================================================================
# Official Recipient Email for website enquiries
ENQUIRY_RECIPIENT_EMAIL=harsh.singh.2003dydt@gmail.com

# Primary Provider: Resend Transactional Email API (Recommended for Render)
# Sign up at https://resend.com, generate an API key, and verify your sending domain
RESEND_API_KEY=
# E.g. "Shobha Education Trust <admissions@yourverifieddomain.com>" or "Shobha Education Trust <onboarding@resend.dev>" during testing
ENQUIRY_FROM_EMAIL=

# Secondary / Fallback Provider: SMTP Transport
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
