# ==============================================================================
# Backend Dockerfile for Shobha Education Trust API
# ==============================================================================
FROM node:22-alpine AS backend-runner

WORKDIR /app

# Install curl for container health check
RUN apk add --no-cache curl

# Copy dependency manifests
COPY package.json package-lock.json* ./

# Install production dependencies
RUN npm install --omit=dev --no-audit --no-fund

# Copy backend source code and seed scripts
COPY server/ ./server/
COPY scripts/ ./scripts/
COPY assets/ ./assets/

# Prepare persistent data directories
RUN mkdir -p /app/data/uploads /app/data/db

# Default environment variables
ENV NODE_ENV=production \
    PORT=5001 \
    UPLOAD_DIR=data/uploads

# Expose backend API port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:5001/api/health || exit 1

# Start backend server
CMD ["node", "server/server.js"]
